{
    "name": "justinholtweb/craft-chisel",
    "description": "Run allowlisted Artisan commands from the Craft CP — forms built from each command's signature, permission per command, full audit log.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "chisel",
        "laravel"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Chisel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Chisel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "support": {
        "docs": "https://justinholt.com/plugins/craft-chisel/docs",
        "issues": "https://github.com/justinholtweb/craft-chisel/issues",
        "source": "https://github.com/justinholtweb/craft-chisel"
    },
    "extra": {
        "name": "Chisel",
        "handle": "chisel",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-chisel/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-chisel/main/CHANGELOG.md",
        "class": "JustinHoltWeb\\Chisel\\Plugin"
    }
}
